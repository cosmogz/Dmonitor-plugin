{
  "name": "dmonitor-service",
  "version": "0.1.0",
  "private": true,
  "description": "Dmonitor external microservice scaffold for glucose monitoring and OpenMRS integration.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "lint": "eslint . --ext .ts",
    "test": "jest --config jest.config.js --runInBand",
    "ci": "npm run build && npm run lint",
    "compose:up": "docker-compose up -d",
    "compose:down": "docker-compose down"
    ,"migrate": "node scripts/migrate.js"
  },

  "docker": {
    "compose": "docker-compose.yml"
  },
  "dependencies": {
    "jwks-rsa": "^3.0.0",
    "jsonwebtoken": "^9.0.0",
    "prom-client": "^14.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.11.1",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.1.13"
  },
  "devDependencies": {
    "nock": "^13.3.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.18",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "eslint": "^8.57.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
