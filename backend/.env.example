# Dmonitor backend example env
PORT=3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/dmonitor
REDIS_URL=redis://127.0.0.1:6379

# Notification settings
DEFAULT_NOTIFICATION_CHANNEL=webhook
NOTIFICATION_MAX_ATTEMPTS=5

# Email (SMTP) settings
SMTP_URL=
SMTP_ALLOW_INSECURE=false

# Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Alert thresholds (override defaults)
ALERT_LOW_CRIT=54
ALERT_LOW_WARN=70
ALERT_HIGH_WARN=180
ALERT_HIGH_CRIT=300

# OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Sync
SYNC_WORKER=true

PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dmonitor
JWT_SECRET=change-me-to-a-secure-secret
