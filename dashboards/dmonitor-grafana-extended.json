{
  "annotations": {"list":[]},
  "panels": [
    {
      "type": "gauge",
      "title": "OpenMRS Circuit Open",
      "targets": [
        { "expr": "openmrs_circuit_open", "legendFormat": "" }
      ],
      "gridPos": {"h":6,"w":6,"x":0,"y":0}
    },
    {
      "type": "graph",
      "title": "OpenMRS error rate (5m)",
      "targets": [
        { "expr": "increase(openmrs_circuit_open_count[5m])", "legendFormat": "errors (5m)" }
      ],
      "gridPos": {"h":8,"w":12,"x":6,"y":0}
    },
    {
      "type": "timeseries",
      "title": "Request Latency (p50/p95)",
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }
      ],
      "gridPos": {"h":8,"w":12,"x":0,"y":8}
    }
  ],
  "schemaVersion": 30,
  "title": "Dmonitor Extended Overview",
  "version": 1
}
